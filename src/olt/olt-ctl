#!/bin/bash
# Send a control command to the running omarchy-live-translator controller.
# Usage: olt-ctl <action> [--source <lang>] [--target <lang>]
#        olt-ctl status
#        olt-ctl diagnostics

set -u

CTL_PORT=8670
ACTION=""
SOURCE=""
TARGET=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --source) SOURCE="$2"; shift 2 ;;
        --target) TARGET="$2"; shift 2 ;;
        *) ACTION="$1"; shift ;;
    esac
done

if [ -z "$ACTION" ]; then
    echo "usage: $0 <ptt_start|ptt_stop|speak|clear|pause_incoming|status|diagnostics>" >&2
    exit 2
fi

if [ "$ACTION" = "diagnostics" ]; then
    echo "=== omarchy-live-translator diagnostics ==="
    echo
    echo "--- service state ---"
    systemctl --user is-active omarchy-live-translator.service libretranslate-live.service 2>&1
    echo
    echo "--- controller status ---"
    curl -fsS --max-time 3 http://127.0.0.1:8670/status 2>&1 || echo "(controller not responding)"
    echo
    echo "--- latency summary (events.jsonl) ---"
    EVENTS="$HOME/.local/state/omarchy-live-translator/events.jsonl"
    if [ -f "$EVENTS" ]; then
        python3 - "$EVENTS" <<'EOF'
import json, sys
from collections import defaultdict
path = sys.argv[1]
acc = defaultdict(list)
kinds = defaultdict(int)
try:
    with open(path, encoding="utf-8") as fh:
        lines = fh.readlines()
except OSError:
    lines = []
for line in lines:
    try:
        ev = json.loads(line)
    except json.JSONDecodeError:
        continue
    kinds[ev.get("kind", "?")] += 1
    for key in ("asr_ms", "nmt_ms", "tts_ms", "play_ms"):
        v = ev.get(key)
        if isinstance(v, (int, float)):
            acc[key].append(v)
print("events by kind:", dict(kinds))
for key in ("asr_ms", "nmt_ms", "tts_ms", "play_ms"):
    vals = acc[key]
    if not vals:
        continue
    n = len(vals)
    avg = sum(vals) / n
    lo = min(vals)
    hi = max(vals)
    print(f"{key}: n={n} avg={avg:.1f} min={lo:.1f} max={hi:.1f} (ms)")
if not lines:
    print("(no events recorded yet)")
EOF
    else
        echo "(no events file yet)"
    fi
    echo
    echo "--- recent log (olt) ---"
    journalctl --user -u omarchy-live-translator.service --no-pager -n 40 2>&1
    echo
    echo "--- recent log (libretranslate-live) ---"
    journalctl --user -u libretranslate-live.service --no-pager -n 20 2>&1
    echo
    echo "--- hardware / engine ---"
    ~/.local/bin/nemo-speech doctor 2>&1 || echo "(nemo-speech doctor failed)"
    exit 0
fi

python3 - "$ACTION" "$SOURCE" "$TARGET" <<'EOF'
import json, sys, urllib.request
action, source, target = sys.argv[1], sys.argv[2], sys.argv[3]
msg = {"action": action}
if source:
    msg["source_lang"] = source
if target:
    msg["target"] = target
if action == "status":
    try:
        with urllib.request.urlopen("http://127.0.0.1:8670/status", timeout=5) as r:
            print(json.dumps(json.loads(r.read()), indent=2))
    except Exception as e:
        print(f"olt-ctl: {e}", file=sys.stderr)
        sys.exit(1)
    sys.exit(0)
req = urllib.request.Request(
    "http://127.0.0.1:8670/ctl",
    data=json.dumps(msg).encode(),
    headers={"Content-Type": "application/json"},
    method="POST",
)
try:
    urllib.request.urlopen(req, timeout=5)
except Exception as e:
    print(f"olt-ctl: {e}", file=sys.stderr)
    sys.exit(1)
EOF
