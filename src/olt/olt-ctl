#!/bin/bash
# Send a control command to the running omarchy-live-translator controller.
# Usage: olt-ctl <action> [--source <lang>] [--target <lang>]

set -u

CTL_PORT=8670
ACTION=""
SOURCE=""
TARGET=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --source) SOURCE="$2"; shift 2 ;;
        --target) TARGET="$2"; shift 2 ;;
        *) ACTION="$1"; shift ;;
    esac
done

if [ -z "$ACTION" ]; then
    echo "usage: $0 <ptt_start|ptt_stop|speak|clear|pause_incoming>" >&2
    exit 2
fi

python3 - "$ACTION" "$SOURCE" "$TARGET" <<'EOF'
import json, sys, urllib.request
action, source, target = sys.argv[1], sys.argv[2], sys.argv[3]
msg = {"action": action}
if source:
    msg["source_lang"] = source
if target:
    msg["target"] = target
req = urllib.request.Request(
    "http://127.0.0.1:8670/ctl",
    data=json.dumps(msg).encode(),
    headers={"Content-Type": "application/json"},
    method="POST",
)
try:
    urllib.request.urlopen(req, timeout=5)
except Exception as e:
    print(f"olt-ctl: {e}", file=sys.stderr)
    sys.exit(1)
EOF
